/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/notes/
  Cache-Control: no-cache
/notes/index.html
  Cache-Control: no-cache
/notes/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/notes/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/notes/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800
/notes/icons/*
  Cache-Control: public, max-age=604800
